# Copie este archivo como .env.local (NUNCA lo suba a Git) y complete los valores.

# Públicas: configuración web de Firebase (es pública por diseño).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Solo servidor: cuenta de servicio del Admin SDK y secretos propios.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# En Vercel va con \n literales; el servidor los convierte a saltos de línea.
FIREBASE_PRIVATE_KEY=
CRON_SECRET=

# Opcional: URL pública del sitio (además del propio origen) aceptada en la comprobación de Origin.
APP_URL=
