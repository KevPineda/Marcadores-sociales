meta {
  name: Crear sesion - 204
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/sesion
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
}

body:json {
  {
    "idToken": "{{idToken}}"
  }
}

assert {
  res.status: eq 204
}

docs {
  Registra la sesión: responde Set-Cookie sesion=…; HttpOnly; Secure; SameSite=Lax.
}
